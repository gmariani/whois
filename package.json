{
  "name": "domain-inspector",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "PHP_CLI_SERVER_WORKERS=8 php -S localhost:8000 index.php",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "package": "node scripts/package.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/google.maps": "^3.66.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
