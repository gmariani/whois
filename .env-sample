# production | development
APP_ENV=production
# Public URL of the site; used in the User-Agent sent to RDAP/registry servers.
APP_URL=https://mariani.life/projects/dns/

# Google Maps JavaScript API key (restrict it to your domain in the Google Cloud console).
GOOGLE_MAPS=""

# Development only: load the front-end from the Vite dev server (npm run dev).
# VITE_DEV_SERVER=http://localhost:5173

# --- Geolocation -----------------------------------------------------------
# ipinfo.io token (https://ipinfo.io/account/token). Used first while it has quota;
# when it hits its limit (HTTP 429) lookups use the local database for an hour.
IP_INFO=""
# Local databases downloaded by `php app/bin/update-geoip.php` (defaults shown).
# GEOIP_CITY_DB=storage/geoip/dbip-city-lite.mmdb
# GEOIP_ASN_DB=storage/geoip/dbip-asn-lite.mmdb
# When those files are missing: "ip-api" (free, rate limited) or "none".
GEO_FALLBACK=ip-api

# --- DNS -------------------------------------------------------------------
# Recursive resolvers used only to find each zone's own name servers.
# DNS_RESOLVERS=1.1.1.1,8.8.8.8,9.9.9.9

# --- Abuse protection --------------------------------------------------------
# Per client IP, per RATE_LIMIT_WINDOW seconds:
RATE_LIMIT_LOOKUPS=30
RATE_LIMIT_REQUESTS=400
RATE_LIMIT_WINDOW=600
# API calls allowed per page load (8 sections + retries), and how long a page's token lasts.
RATE_LIMIT_PER_TOKEN=40
TOKEN_TTL=1800
# Behind Cloudflare or another proxy, the header carrying the real client IP:
# CLIENT_IP_HEADER=CF-Connecting-IP
